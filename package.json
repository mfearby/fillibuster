{
  "name": "fillibuster",
  "version": "0.1.0",
  "description": "Cross-browser (Firefox + Chrome) extension that fills web forms from saved, reusable fill configs.",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build:firefox": "node scripts/build.mjs firefox",
    "build:chrome": "node scripts/build.mjs chrome",
    "build": "node scripts/build.mjs",
    "package": "node scripts/build.mjs --package",
    "dev": "node scripts/build.mjs --watch"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.0",
    "@testing-library/preact": "^3.2.4",
    "@types/webextension-polyfill": "^0.12.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "web-ext": "^8.3.0"
  },
  "dependencies": {
    "preact": "^10.24.0",
    "webextension-polyfill": "^0.12.0"
  }
}
